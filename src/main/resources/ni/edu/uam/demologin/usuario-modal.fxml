<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.demologin.controller.UsuarioModalController"
      prefHeight="480" prefWidth="520"
      alignment="CENTER"
      spacing="10">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>
    <Label text="EDITAR USUARIO"
           style="-fx-font-size:22px;
                  -fx-font-weight:bold"/>
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="220.0"/>
            <ColumnConstraints/>
        </columnConstraints>

        <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Apellido" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Correo" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Usuario" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtUsuario" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Button text="CAMBIAR FOTO" onAction="#cambiarFoto"/>
    <ImageView fx:id="imageFoto"
               fitWidth="150"
               fitHeight="150"
               preserveRatio="true"/>
    <HBox alignment="CENTER" spacing="15">
        <Button text="GUARDAR" onAction="#guardar" prefWidth="120"/>
        <Button text="CANCELAR" onAction="#cancelar" prefWidth="120"/>
    </HBox>
    
</VBox>
